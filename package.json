{
  "name": "leash-protocol",
  "version": "0.1.0",
  "description": "LEASH — live mandate jury and kill switch for AI agents (GenLayer Agent Tank Hackathon)",
  "license": "MIT",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy": "hardhat run scripts/deploy.js",
    "deploy:localhost": "hardhat run scripts/deploy.js --network localhost",
    "deploy:studio": "hardhat run scripts/deploy.js --network genlayer_studio",
    "deploy:studio-next": "hardhat run scripts/deploy.js --network studio_next",
    "deploy:studio-py": "node scripts/deploy_leash_py.mjs",
    "jury:seed": "node scripts/adjudicate.mjs",
    "studio:1": "hardhat run studio_cases/1_in_mandate.js --network genlayer_studio",
    "studio:2": "hardhat run studio_cases/2_soft_drift.js --network genlayer_studio",
    "studio:3": "hardhat run studio_cases/3_overspend.js --network genlayer_studio",
    "studio:interactive": "hardhat run studio_cases/interactive_test.js",
    "node": "hardhat node"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.17"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0",
    "dotenv": "^17.4.2",
    "genlayer-js": "^2.0.0-rc.1"
  }
}
